#!/bin/sh
# Maven Wrapper startup script for Unix/Linux/Mac
# Usage: ./mvnw <goals> <options>

set -e

MAVEN_PROJECTBASEDIR="${MAVEN_PROJECTBASEDIR:-$(dirname "$0")}"
export MAVEN_PROJECTBASEDIR

MAVEN_WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
MAVEN_WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"
MAVEN_WRAPPER_DOWNLOAD_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar"

# Check for java
if [ -z "$JAVA_HOME" ] && ! command -v java >/dev/null 2>&1; then
    echo "Error: JAVA_HOME is not set and no java command could be found." >&2
    exit 1
fi

# Download wrapper if not present
if [ ! -f "$MAVEN_WRAPPER_JAR" ]; then
    echo "Downloading Maven Wrapper..."
    mkdir -p "$MAVEN_PROJECTBASEDIR/.mvn/wrapper"
    if command -v curl >/dev/null 2>&1; then
        curl -sL "$MAVEN_WRAPPER_DOWNLOAD_URL" -o "$MAVEN_WRAPPER_JAR"
    elif command -v wget >/dev/null 2>&1; then
        wget -q "$MAVEN_WRAPPER_DOWNLOAD_URL" -O "$MAVEN_WRAPPER_JAR"
    else
        echo "Error: Neither curl nor wget found." >&2
        exit 1
    fi
fi

# Extract distributionUrl from properties
MAVEN_DIST_URL=$(grep 'distributionUrl' "$MAVEN_WRAPPER_PROPERTIES" | sed 's/.*=//' | tr -d '\r')

# Determine Maven home
MAVEN_HOME="$HOME/.m2/wrapper/dists/$(echo "$MAVEN_DIST_URL" | sed 's/.*\///' | sed 's/\.zip$//')"

if [ ! -d "$MAVEN_HOME" ]; then
    echo "Downloading Maven from $MAVEN_DIST_URL..."
    mkdir -p "$MAVEN_HOME"
    TEMP_FILE=$(mktemp)
    if command -v curl >/dev/null 2>&1; then
        curl -sL "$MAVEN_DIST_URL" -o "$TEMP_FILE"
    elif command -v wget >/dev/null 2>&1; then
        wget -q "$MAVEN_DIST_URL" -O "$TEMP_FILE"
    fi
    unzip -q "$TEMP_FILE" -d "$MAVEN_HOME"
    rm -f "$TEMP_FILE"
    # Move contents up if nested
    NESTED=$(ls "$MAVEN_HOME")
    if [ $(echo "$NESTED" | wc -l) -eq 1 ] && [ -d "$MAVEN_HOME/$NESTED" ]; then
        mv "$MAVEN_HOME/$NESTED"/* "$MAVEN_HOME/"
        rmdir "$MAVEN_HOME/$NESTED"
    fi
fi

exec "$MAVEN_HOME/bin/mvn" "$@"
